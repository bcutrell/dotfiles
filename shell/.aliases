# Shared by .zshrc and .bashrc: environment first, then aliases.
export LANG=en_US.UTF-8   # not LC_ALL: it breaks on images without the locale generated
export PATH="$HOME/.local/bin:$PATH"
[ -d "$HOME/go/bin" ] && export PATH="$PATH:$HOME/go/bin"
[ -f "$HOME/.rye/env" ] && . "$HOME/.rye/env"
command -v nvim >/dev/null 2>&1 && export EDITOR=nvim || export EDITOR=vim
command -v batcat >/dev/null 2>&1 && ! command -v bat >/dev/null 2>&1 && alias bat=batcat
if command -v rg >/dev/null 2>&1; then
    export FZF_DEFAULT_COMMAND='rg --files --hidden --glob "!.git"'
    export FZF_CTRL_T_COMMAND="$FZF_DEFAULT_COMMAND"
fi

alias c="clear"
alias search="rg -S --no-ignore"
alias nvim_config='$EDITOR ~/.config/nvim/init.lua'
alias restart_shell='exec "$SHELL"'
alias ..="cd .."
alias ...="cd ../.."
alias ....="cd ../../.."

alias gs="git status"
alias gco="git checkout"
alias ggn="git grep -n"
alias gd="git diff"
alias gb="git branch"
alias gl="git log"
alias gc="git commit"
alias gitapplyplz="git apply --ignore-space-change --ignore-whitespace"
alias gbds="git for-each-ref --sort=-committerdate --format='%(committerdate:short) %(refname:short)' refs/heads/"

case $OSTYPE in
darwin*)
    alias dirsize='du -d 1 -h . | sort -rh'
    alias ports='sudo lsof -nP -iTCP -sTCP:LISTEN'
    ;;
*)
    alias dirsize='du -h --max-depth=1 | sort -hr'
    alias ports='sudo ss -tulpn'
    ;;
esac
alias listening=ports
alias openports='sudo lsof -i'

# findlarge [dir] [count]
findlarge() {
    find "${1:-.}" -type f -print0 2>/dev/null | xargs -0 du -h 2>/dev/null | sort -rh | head -n "${2:-10}"
}

mv_unstaged() {
    mkdir -p unstaged
    git ls-files --others --exclude-standard | while IFS= read -r f; do
        mkdir -p "unstaged/$(dirname "$f")"
        mv "$f" "unstaged/$f"
    done
}
