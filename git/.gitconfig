# Identity and credential helper live in ~/.gitconfig.local (written by setup.sh).
[include]
	path = ~/.gitconfig.local

[core]
	excludesfile = ~/.gitignore_global

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	autoSetupRemote = true

[rebase]
	autoStash = true

[alias]
	lg = log --oneline --graph --decorate --all
